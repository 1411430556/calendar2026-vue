# 依赖与构建产物
node_modules
dist

# Vite 缓存
.vite
*.tsbuildinfo

# 日志（*.log 已覆盖各包管理器调试日志；*debug.log* 兜底带轮转后缀的文件）
*.log
*debug.log*

# 本地环境变量（保留 .env / .env.example 可提交）
.env.local
.env.*.local

# 测试覆盖率（vitest 的 lcov.info 等产物均在 coverage/ 内）
coverage

# 编辑器 / 操作系统
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# 项目使用 pnpm，忽略其它包管理器的锁文件
package-lock.json
yarn.lock

# Trae IDE 本地 HTML 分享产物
.trae-html-share-packages/

# Trae IDE 本地状态：默认忽略 .trae 下所有内容，仅保留团队共享的 rules 规则目录
.trae/*
!.trae/rules/
